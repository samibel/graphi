ript for the specified shell\","},{"path":"completions.go","start_line":715,"end_line":715,"text":"\t\tShort: fmt.Sprintf(shortDesc, \"bash\"),"},{"path":"completions.go","start_line":26,"end_line":33,"text":"const (\n\t// ShellCompRequestCmd is the name of the hidden command that is used to request\n\t// completion results from the program.  It is used by the shell completion scripts.\n\tShellCompRequestCmd = \"__complete\"\n\t// ShellCompNoDescRequestCmd is the name of the hidden command that is used to request\n\t// completion results without their description.  It is used by the shell completion scripts.\n\tShellCompNoDescRequestCmd = \"__completeNoDesc\"\n)"},{"path":"powershell_completions.go","start_line":34,"end_line":35,"text":"\tcompCmd := ShellCompRequestCmd\n\tif !includeDesc {"},{"path":"powershell_completions.go","start_line":61,"end_line":61,"text":"    __%[1]s_debug \"\""},{"path":"bash_completionsV2.go","start_line":32,"end_line":32,"text":"\tcompCmd := ShellCompRequestCmd"},{"path":"zsh_completions.go","start_line":88,"end_line":88,"text":"\tcompCmd := ShellCompRequestCmd"},{"path":"fish_completions.go","start_line":31,"end_line":31,"text":"\tcompCmd := ShellCompRequestCmd"},{"path":"fish_completions.go","start_line":150,"end_line":150,"text":"    __%[1]s_debug \"\""}],"provenance":{"input_sha256":"e97edda1b180711e1a67ed2404d52d07d956ddf4c3046c62ca491ccb4da6fb21","method":"task_context/2","retrieval":"retrieval/7","weights":"b6ccb635","model":"sha256:85978034abd2ab89","source_selection":"context-definitions/3","source_order":"ranked_coherent_regions","source_budget":250,"source_budget_unit":"whitespace-fields-v1"},"truncated":true},"isError":false}}
